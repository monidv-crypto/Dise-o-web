<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cafetería & Repostería Web App</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts (Cabin y Changa One) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cabin:ital,wght@0,400..700;1,400..700&family=Changa+One:ital@0;1&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        // Colores basados en variables CSS para soportar modo oscuro
                        'wire-bg': 'rgb(var(--wire-bg-rgb) / <alpha-value>)',
                        'wire-card': 'rgb(var(--wire-card-rgb) / <alpha-value>)',
                        'wire-white': 'rgb(var(--wire-white-rgb) / <alpha-value>)',
                        'wire-yellow': 'rgb(var(--wire-yellow-rgb) / <alpha-value>)',
                        'wire-yellow-hover': 'rgb(var(--wire-yellow-hover-rgb) / <alpha-value>)',
                        'wire-mint': 'rgb(var(--wire-mint-rgb) / <alpha-value>)',
                        'wire-mint-dark': 'rgb(var(--wire-mint-dark-rgb) / <alpha-value>)',
                        'wire-salmon': 'rgb(var(--wire-salmon-rgb) / <alpha-value>)',
                        'wire-salmon-dark': 'rgb(var(--wire-salmon-dark-rgb) / <alpha-value>)',
                        'wire-gray': 'rgb(var(--wire-gray-rgb) / <alpha-value>)',
                        'wire-graytext': 'rgb(var(--wire-graytext-rgb) / <alpha-value>)',
                        'wire-text': 'rgb(var(--wire-text-rgb) / <alpha-value>)'
                    },
                    fontFamily: {
                        sans: ['Cabin', 'sans-serif'],
                        display: ['Changa One', 'cursive']
                    }
                }
            }
        }
    </script>

    <style>
        /* ============ MODO CLARO (por defecto) ============ */
        :root {
            color-scheme: light;
            --wire-bg-rgb: 245 239 224;          /* #F5EFE0 Beige/Crema */
            --wire-card-rgb: 250 246 236;        /* #FAF6EC Fondo de tarjetas */
            --wire-white-rgb: 255 255 255;       /* #FFFFFF Superficies blancas */
            --wire-yellow-rgb: 217 155 0;        /* #D99B00 Dorado/Mostaza */
            --wire-yellow-hover-rgb: 184 131 0;  /* #B88300 */
            --wire-mint-rgb: 128 196 183;        /* #80C4B7 Verde menta */
            --wire-mint-dark-rgb: 97 163 150;    /* #61A396 */
            --wire-salmon-rgb: 239 163 146;      /* #EFA392 Salmón */
            --wire-salmon-dark-rgb: 217 137 119; /* #D98977 */
            --wire-gray-rgb: 209 213 219;        /* #D1D5DB */
            --wire-graytext-rgb: 107 114 128;    /* #6B7280 (texto secundario) */
            --wire-text-rgb: 56 49 43;           /* #38312B */
        }

        /* ============ MODO OSCURO ============ */
        .dark {
            color-scheme: dark;
            --wire-bg-rgb: 42 33 24;             /* #2A2118 Café oscuro (fondo) */
            --wire-card-rgb: 54 43 33;           /* #362B21 Café para tarjetas */
            --wire-white-rgb: 69 56 41;          /* #453829 Café para superficies */
            --wire-text-rgb: 245 239 224;        /* #F5EFE0 Beige (letras) */
            --wire-graytext-rgb: 196 181 156;    /* #C4B59C Beige suave (texto secundario) */
        }

        body {
            background-color: rgb(var(--wire-bg-rgb));
            color: rgb(var(--wire-text-rgb));
            font-family: 'Cabin', sans-serif;
            -webkit-tap-highlight-color: transparent;
            transition: background-color 0.4s ease, color 0.4s ease;
        }

        /* Ocultar scrollbar para los carruseles */
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

        /* Transición suave para cambio de pestañas */
        .tab-content { animation: fadeIn 0.4s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* Estilos Inputs Contacto */
        .input-style {
            background-color: rgba(239, 163, 146, 0.15); /* Salmón muy tenue */
            border: 1px solid #EFA392;
            color: rgb(var(--wire-text-rgb));
        }
        .input-style::placeholder {
            color: rgb(var(--wire-graytext-rgb) / 0.75);
            opacity: 1;
        }
        .input-style:focus {
            background-color: rgb(var(--wire-white-rgb));
            outline: none;
            border-color: #D99B00;
            box-shadow: 0 0 0 2px rgba(217, 155, 0, 0.2);
        }
    </style>

    <script>
        // Aplica el tema guardado ANTES de pintar la página (evita parpadeo)
        (function () {
            const saved = localStorage.getItem('theme');
            if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
</head>
<body class="min-h-screen pt-28 pb-12">

    <!-- HEADER FIJO -->
    <header class="fixed top-0 w-full max-w-4xl mx-auto bg-wire-bg z-40 shadow-sm">
        <div class="px-4 py-3 flex items-center justify-between border-b border-wire-text/10">
            <div class="flex items-center gap-2 cursor-pointer" onclick="switchTab('home')">
                <div class="w-8 h-8 rounded-full bg-wire-yellow flex items-center justify-center text-white font-bold text-sm shadow-xs">
                    <i class="fa-solid fa-mug-hot"></i>
                </div>
                <span class="font-display text-xl text-wire-text tracking-wide">Café & Repostería</span>
            </div>
            
            <div class="flex items-center gap-1">
                <!-- Botón Modo Claro / Oscuro -->
                <button onclick="toggleDarkMode()" id="theme-toggle" class="p-2 text-wire-text hover:text-wire-yellow transition" title="Cambiar modo claro/oscuro" aria-label="Cambiar modo claro/oscuro">
                    <i class="fa-solid fa-moon text-xl"></i>
                </button>

                <!-- Notificación Carrito -->
                <button onclick="switchTab('compras')" class="relative p-2 text-wire-text hover:text-wire-yellow transition">
                    <i class="fa-solid fa-bag-shopping text-xl"></i>
                    <span id="cart-badge-count" class="absolute -top-1 -right-1 bg-wire-salmon text-white text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center border-2 border-wire-bg">0</span>
                </button>
            </div>
        </div>

        <!-- NAVEGACIÓN PRINCIPAL SUPERIOR -->
        <nav class="flex items-center justify-around h-12 bg-wire-card text-sm">
            <button onclick="switchTab('home')" id="nav-home" class="nav-btn font-semibold text-wire-graytext hover:text-wire-text transition px-4 py-2 border-b-2 border-transparent">
                Home
            </button>
            <button onclick="switchTab('productos')" id="nav-productos" class="nav-btn font-semibold text-wire-graytext hover:text-wire-text transition px-4 py-2 border-b-2 border-transparent">
                Productos
            </button>
            <button onclick="switchTab('muro')" id="nav-muro" class="nav-btn font-semibold text-wire-graytext hover:text-wire-text transition px-4 py-2 border-b-2 border-transparent">
                Muro
            </button>
            <button onclick="switchTab('compras')" id="nav-compras" class="nav-btn font-semibold text-wire-graytext hover:text-wire-text transition px-4 py-2 border-b-2 border-transparent">
                Compras
            </button>
        </nav>
    </header>

    <main class="w-full max-w-4xl mx-auto px-4">

        <!-- ======================================================= -->
        <!-- PESTAÑA: HOME (LANDING PAGE)                            -->
        <!-- ======================================================= -->
        <section id="tab-home" class="tab-content space-y-16 py-6">
            
            <!-- 1. SECCIÓN POSTRES -->
            <div id="home-postres">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-3xl font-display text-wire-text">Postres</h2>
                    <button onclick="switchTab('productos', 'pasteles')" class="text-sm text-wire-yellow font-bold hover:underline">Ver todo</button>
                </div>
                <div id="carousel-postres" class="relative">
                    <div class="flex overflow-x-auto scroll-smooth snap-x snap-mandatory gap-5 pb-6 scrollbar-hide">
                        <!-- JS poblará esto -->
                    </div>
                    <!-- Flechas -->
                    <button onclick="moveCarousel('carousel-postres', -1)" class="absolute top-1/2 -translate-y-1/2 -left-3 w-9 h-9 bg-wire-white rounded-full shadow-md flex items-center justify-center text-wire-text hover:bg-wire-yellow hover:text-white transition">
                        <i class="fa-solid fa-chevron-left text-sm"></i>
                    </button>
                    <button onclick="moveCarousel('carousel-postres', 1)" class="absolute top-1/2 -translate-y-1/2 -right-3 w-9 h-9 bg-wire-white rounded-full shadow-md flex items-center justify-center text-wire-text hover:bg-wire-yellow hover:text-white transition">
                        <i class="fa-solid fa-chevron-right text-sm"></i>
                    </button>
                    <!-- Dots -->
                    <div id="dots-postres" class="flex justify-center gap-2 mt-2"></div>
                </div>
            </div>

            <!-- 2. SECCIÓN BEBIDAS -->
            <div id="home-bebidas">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-3xl font-display text-wire-text">Bebidas</h2>
                    <button onclick="switchTab('productos', 'bebidas-calientes')" class="text-sm text-wire-yellow font-bold hover:underline">Ver todo</button>
                </div>
                <div id="carousel-bebidas" class="relative">
                    <div class="flex overflow-x-auto scroll-smooth snap-x snap-mandatory gap-5 pb-6 scrollbar-hide">
                        <!-- JS poblará esto -->
                    </div>
                    <button onclick="moveCarousel('carousel-bebidas', -1)" class="absolute top-1/2 -translate-y-1/2 -left-3 w-9 h-9 bg-wire-white rounded-full shadow-md flex items-center justify-center text-wire-text hover:bg-wire-yellow hover:text-white transition">
                        <i class="fa-solid fa-chevron-left text-sm"></i>
                    </button>
                    <button onclick="moveCarousel('carousel-bebidas', 1)" class="absolute top-1/2 -translate-y-1/2 -right-3 w-9 h-9 bg-wire-white rounded-full shadow-md flex items-center justify-center text-wire-text hover:bg-wire-yellow hover:text-white transition">
                        <i class="fa-solid fa-chevron-right text-sm"></i>
                    </button>
                    <div id="dots-bebidas" class="flex justify-center gap-2 mt-2"></div>
                </div>
            </div>

            <!-- 3. SECCIÓN MURO -->
            <div id="home-muro">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-3xl font-display text-wire-text">Muro</h2>
                    <button onclick="switchTab('muro')" class="text-sm text-wire-yellow font-bold hover:underline">Ver todo</button>
                </div>
                <div id="carousel-muro" class="relative">
                    <div class="flex overflow-x-auto scroll-smooth snap-x snap-mandatory gap-5 pb-6 scrollbar-hide">
                        <!-- JS poblará esto -->
                    </div>
                    <button onclick="moveCarousel('carousel-muro', -1)" class="absolute top-1/2 -translate-y-1/2 -left-3 w-9 h-9 bg-wire-white rounded-full shadow-md flex items-center justify-center text-wire-text hover:bg-wire-yellow hover:text-white transition">
                        <i class="fa-solid fa-chevron-left text-sm"></i>
                    </button>
                    <button onclick="moveCarousel('carousel-muro', 1)" class="absolute top-1/2 -translate-y-1/2 -right-3 w-9 h-9 bg-wire-white rounded-full shadow-md flex items-center justify-center text-wire-text hover:bg-wire-yellow hover:text-white transition">
                        <i class="fa-solid fa-chevron-right text-sm"></i>
                    </button>
                    <div id="dots-muro" class="flex justify-center gap-2 mt-2"></div>
                </div>
            </div>

            <!-- 4. SECCIÓN CONTACTO -->
            <div id="home-contacto" class="bg-wire-mint/20 p-6 sm:p-10 rounded-3xl border border-wire-mint/30">
                <h2 class="text-3xl font-display text-wire-text mb-6">Contacto</h2>
                <form onsubmit="event.preventDefault(); showToast('Mensaje enviado con éxito. ¡Gracias por contactarnos!');" class="space-y-5 max-w-lg mx-auto">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-wire-text/80 uppercase mb-1.5">Nombre</label>
                            <input type="text" required class="input-style w-full px-4 py-2.5 rounded-xl text-sm font-medium text-wire-text transition" placeholder="Tu nombre">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-wire-text/80 uppercase mb-1.5">Teléfono</label>
                            <input type="tel" required class="input-style w-full px-4 py-2.5 rounded-xl text-sm font-medium text-wire-text transition" placeholder="+52 55 1234 5678">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-wire-text/80 uppercase mb-1.5">Correo Electrónico</label>
                        <input type="email" required class="input-style w-full px-4 py-2.5 rounded-xl text-sm font-medium text-wire-text transition" placeholder="correo@ejemplo.com">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-wire-text/80 uppercase mb-1.5">Mensaje</label>
                        <textarea rows="4" required class="input-style w-full px-4 py-2.5 rounded-xl text-sm font-medium text-wire-text transition resize-none" placeholder="Escribe aquí tu mensaje, pedido especial o duda..."></textarea>
                    </div>
                    <button type="submit" class="w-full bg-wire-yellow hover:bg-wire-yellow-hover text-white font-bold py-3 rounded-xl shadow-sm transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-paper-plane"></i> Enviar Mensaje
                    </button>
                </form>
            </div>

        </section>

        <!-- ======================================================= -->
        <!-- PESTAÑA: PRODUCTOS                                      -->
        <!-- ======================================================= -->
        <section id="tab-productos" class="tab-content hidden space-y-8 py-6">
            <h1 class="text-3xl font-display text-wire-text">Nuestros Productos</h1>
            
            <!-- Subcategorías -->
            <div class="flex items-center gap-2 overflow-x-auto scrollbar-hide pb-2">
                <button onclick="filterSubcategory('pasteles', this)" class="subcat-btn flex-shrink-0 text-sm font-bold px-5 py-2 bg-wire-yellow text-white rounded-full transition shadow-xs">Pasteles</button>
                <button onclick="filterSubcategory('pays', this)" class="subcat-btn flex-shrink-0 text-sm font-bold px-5 py-2 bg-wire-white text-wire-graytext rounded-full hover:bg-wire-text/10 transition">Pays</button>
                <button onclick="filterSubcategory('bebidas-frias', this)" class="subcat-btn flex-shrink-0 text-sm font-bold px-5 py-2 bg-wire-white text-wire-graytext rounded-full hover:bg-wire-text/10 transition">Bebidas Frías</button>
                <button onclick="filterSubcategory('bebidas-calientes', this)" class="subcat-btn flex-shrink-0 text-sm font-bold px-5 py-2 bg-wire-white text-wire-graytext rounded-full hover:bg-wire-text/10 transition">Bebidas Calientes</button>
            </div>

            <!-- Grilla de Productos -->
            <div id="products-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-5">
                <!-- JS poblará esto -->
            </div>
        </section>

        <!-- ======================================================= -->
        <!-- PESTAÑA: MURO (GALERÍA CLIENTES)                        -->
        <!-- ======================================================= -->
        <section id="tab-muro" class="tab-content hidden py-6">
            <div class="text-center mb-8">
                <h1 class="text-3xl font-display text-wire-text">Muro de la Comunidad</h1>
                <p class="text-wire-graytext mt-1 text-sm">Las mejores momentos compartidos por nuestros clientes.</p>
            </div>
            <!-- Grilla tipo Masonry adaptativo -->
            <div id="muro-grid" class="grid grid-cols-2 md:grid-cols-3 gap-3">
                <!-- JS poblará esto -->
            </div>
        </section>

        <!-- ======================================================= -->
        <!-- PESTAÑA: COMPRAS (CARRITO Y PERFIL)                     -->
        <!-- ======================================================= -->
        <section id="tab-compras" class="tab-content hidden space-y-10 py-6">
            
            <!-- Carrito -->
            <div class="space-y-5">
                <div class="flex items-center justify-between border-b border-wire-text/15 pb-3">
                    <h2 class="text-2xl font-display text-wire-text flex items-center gap-2">
                        <i class="fa-solid fa-basket-shopping text-wire-yellow"></i> Tu Carrito
                    </h2>
                    <button onclick="clearCart()" class="text-xs text-red-500 font-semibold hover:underline">Vaciar Carrito</button>
                </div>

                <div id="cart-items-container" class="space-y-3"></div>

                <div class="bg-wire-white/80 p-5 rounded-2xl border border-wire-text/10 flex items-center justify-between shadow-sm">
                    <div>
                        <span class="text-xs text-wire-graytext uppercase font-bold tracking-wider">Total a Pagar</span>
                        <div class="text-3xl font-display text-wire-text" id="cart-total-price">$0</div>
                    </div>
                    <button onclick="checkoutModal()" class="bg-wire-mint hover:bg-wire-mint-dark text-white font-bold px-6 py-3 rounded-full shadow-sm transition flex items-center gap-2">
                        <span>Confirmar Pedido</span>
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                </div>
            </div>

            <!-- Perfil -->
            <div class="pt-4 border-t border-wire-text/15">
                <h2 class="text-2xl font-display text-wire-text mb-5 flex items-center gap-2">
                    <i class="fa-solid fa-user-gear text-wire-yellow"></i> Perfil de Usuario
                </h2>

                <div class="max-w-md mx-auto bg-wire-mint rounded-3xl p-6 shadow-md border-4 border-white space-y-4 text-center">
                    <div class="w-20 h-20 mx-auto bg-wire-salmon rounded-xl border-2 border-white shadow-sm flex items-center justify-center text-white text-3xl">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div class="space-y-3 pt-2 text-left">
                        <div>
                            <label class="text-[11px] font-bold text-wire-text/80 uppercase">Nombre Completo</label>
                            <input type="text" value="At vero eos" class="w-full bg-wire-salmon/30 dark:bg-black/25 border border-white/60 text-wire-text font-semibold px-3 py-2 rounded-xl text-sm focus:outline-none focus:bg-wire-white transition">
                        </div>
                        <div>
                            <label class="text-[11px] font-bold text-wire-text/80 uppercase">Teléfono</label>
                            <input type="text" value="+52 55 1234 5678" class="w-full bg-wire-salmon/30 dark:bg-black/25 border border-white/60 text-wire-text font-semibold px-3 py-2 rounded-xl text-sm focus:outline-none focus:bg-wire-white transition">
                        </div>
                        <div>
                            <label class="text-[11px] font-bold text-wire-text/80 uppercase">Dirección</label>
                            <input type="text" value="Av. Principal #45" class="w-full bg-wire-salmon/30 dark:bg-black/25 border border-white/60 text-wire-text font-semibold px-3 py-2 rounded-xl text-sm focus:outline-none focus:bg-wire-white transition">
                        </div>
                    </div>

                    <button onclick="saveProfile()" class="w-full bg-wire-yellow hover:bg-wire-yellow-hover text-white font-bold py-2.5 rounded-xl shadow-sm transition mt-2">
                        Guardar Cambios
                    </button>
                </div>
            </div>
        </section>

    </main>

    <!-- Modal Toast -->
    <div id="toast" class="fixed bottom-5 left-1/2 -translate-x-1/2 bg-wire-text text-wire-bg px-5 py-3 rounded-xl shadow-xl z-50 transition-all duration-300 opacity-0 pointer-events-none flex items-center gap-2 text-sm font-semibold">
        <i class="fa-solid fa-circle-check text-wire-mint"></i>
        <span id="toast-message">Mensaje</span>
    </div>

