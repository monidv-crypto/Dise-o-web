            // Bebidas Calientes
            { id: 13, name: "Cappuccino", category: "bebidas-calientes", price: 70, desc: "Equilibrado espresso, leche y espuma.", img: "https://images.unsplash.com/photo-1572442388796-11668a67e53d?auto=format&fit=crop&w=500&q=60" },
            { id: 14, name: "Latte Vainilla", category: "bebidas-calientes", price: 80, desc: "Suave espresso con leche vaporizada y vainilla.", img: "https://images.unsplash.com/photo-1561882468-9110e03e0f78?auto=format&fit=crop&w=500&q=60" },
            { id: 15, name: "Chocolate Caliente", category: "bebidas-calientes", price: 85, desc: "Chocolate belga espumoso con malvaviscos.", img: "https://images.unsplash.com/photo-1542990253-0b8be3b0e4d3?auto=format&fit=crop&w=500&q=60" },
            { id: 16, name: "Té Chai Latte", category: "bebidas-calientes", price: 75, desc: "Especias aromáticas con leche cremosa.", img: "https://images.unsplash.com/photo-1565452344518-47faca79dc69?auto=format&fit=crop&w=500&q=60" }
        ];

        let cart = [];
        let currentSubcategory = 'pasteles';

        // Imagen de respaldo por si Unsplash falla (mantiene los colores de la web)
        const fallbackImg = "https://placehold.co/500x500/F5EFE0/D99B00?text=Producto";

        // ============= MODO CLARO / OSCURO =============
        function toggleDarkMode() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            updateThemeIcon();
        }

        function updateThemeIcon() {
            const icon = document.querySelector('#theme-toggle i');
            if (icon) {
                const isDark = document.documentElement.classList.contains('dark');
                icon.classList.remove('fa-moon', 'fa-sun');
                icon.classList.add(isDark ? 'fa-sun' : 'fa-moon');
            }
        }

        // ============= MANEJO DE PESTAÑAS =============
        function switchTab(tabName, subcat = null) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('border-wire-text', 'text-wire-text');
                btn.classList.add('text-wire-graytext');
            });

            document.getElementById(`tab-${tabName}`).classList.remove('hidden');
            document.getElementById(`nav-${tabName}`).classList.add('border-wire-text', 'text-wire-text');
            document.getElementById(`nav-${tabName}`).classList.remove('text-wire-graytext');

            if (tabName === 'productos') {
                if (subcat) currentSubcategory = subcat;
                updateSubcatButtons();
                renderProducts();
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ============= RENDERIZADO HOME =============
        function renderCarousels() {
            const postres = PRODUCTS.filter(p => p.category === 'pasteles' || p.category === 'pays');
            const bebidas = PRODUCTS.filter(p => p.category === 'bebidas-frias' || p.category === 'bebidas-calientes');
            const muroImages = [
                "https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=500&q=60",
                "https://images.unsplash.com/photo-1572286258217-215cf8e16567?auto=format&fit=crop&w=500&q=60",
                "https://images.unsplash.com/photo-1568571780765-9276ac8b75a2?auto=format&fit=crop&w=500&q=60",
                "https://images.unsplash.com/photo-1572442388796-11668a67e53d?auto=format&fit=crop&w=500&q=60",
                "https://images.unsplash.com/photo-1571219025102-7ed1d4e0a8d2?auto=format&fit=crop&w=500&q=60",
                "https://images.unsplash.com/photo-1565958011703-44f9829ba187?auto=format&fit=crop&w=500&q=60"
            ];

            renderCarouselItems('carousel-postres', postres, 'dots-postres', 'pasteles');
            renderCarouselItems('carousel-bebidas', bebidas, 'dots-bebidas', 'bebidas-calientes');
            renderMuroCarousel('carousel-muro', muroImages, 'dots-muro');
            renderMuroGrid(muroImages.concat(muroImages)); // Duplicar para llenar grid
        }

        function renderCarouselItems(containerId, items, dotsId, subcatRedirect) {
            const container = document.querySelector(`#${containerId} > div`);
            const dotsContainer = document.getElementById(dotsId);
            container.innerHTML = '';
            dotsContainer.innerHTML = '';

            items.forEach((item, index) => {
                const card = document.createElement('div');
                card.className = "flex-shrink-0 w-[70%] sm:w-[45%] md:w-[31%] snap-start bg-wire-card rounded-2xl p-3 shadow-sm border border-wire-text/10 flex flex-col transition hover:shadow-md";
                card.innerHTML = `
                    <img src="${item.img}" alt="${item.name}" onerror="this.onerror=null;this.src='${fallbackImg}';" onclick="switchTab('productos', '${subcatRedirect}')" class="w-full aspect-square object-cover rounded-xl mb-3 cursor-pointer">
                    <div class="flex-1">
                        <h3 class="font-bold text-wire-text text-base">${item.name}</h3>
                        <p class="text-xs text-wire-graytext leading-tight mt-1 mb-2">${item.desc}</p>
                    </div>
                    <div class="flex items-center justify-between gap-2 mt-2">
                        <span class="font-bold text-wire-yellow text-lg">$${item.price}</span>
                        <button onclick="addToCart(${item.id})" class="bg-wire-yellow hover:bg-wire-yellow-hover text-white text-xs font-bold py-2 px-4 rounded-full transition shadow-xs">
                            Agregar
                        </button>
                    </div>
                `;
                container.appendChild(card);

                // Dots
                const dot = document.createElement('button');
                dot.className = "w-2 h-2 rounded-full bg-wire-text/30 transition-all";
                if (index === 0) dot.classList.add('bg-wire-yellow', 'w-4');
                dot.onclick = () => scrollToCarouselItem(container, index);
                dotsContainer.appendChild(dot);
            });
        }

        function renderMuroCarousel(containerId, images, dotsId) {
            const container = document.querySelector(`#${containerId} > div`);
            const dotsContainer = document.getElementById(dotsId);
            container.innerHTML = '';
            dotsContainer.innerHTML = '';

            images.forEach((imgSrc, index) => {
                const card = document.createElement('div');
                card.className = "flex-shrink-0 w-[80%] sm:w-[45%] md:w-[31%] snap-start relative rounded-2xl overflow-hidden shadow-sm group";
                card.innerHTML = `
                    <img src="${imgSrc}" onerror="this.onerror=null;this.src='${fallbackImg}';" class="w-full aspect-[4/3] object-cover" alt="Foto de cliente">
                    <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent p-4">
                        <p class="text-white text-sm font-semibold flex items-center gap-2">
                            <i class="fa-solid fa-heart text-wire-salmon"></i> Me encanta este lugar
                        </p>
                    </div>
                `;
                container.appendChild(card);

                const dot = document.createElement('button');
                dot.className = "w-2 h-2 rounded-full bg-wire-text/30 transition-all";
                if (index === 0) dot.classList.add('bg-wire-yellow', 'w-4');
                dot.onclick = () => scrollToCarouselItem(container, index);
                dotsContainer.appendChild(dot);
            });
        }

        function renderMuroGrid(images) {
            const grid = document.getElementById('muro-grid');
            grid.innerHTML = '';
            images.forEach(imgSrc => {
                const div = document.createElement('div');
                div.className = "relative rounded-xl overflow-hidden shadow-sm group";
                div.innerHTML = `
                    <img src="${imgSrc}" onerror="this.onerror=null;this.src='${fallbackImg}';" class="w-full h-full object-cover aspect-square" alt="Foto de cliente">
                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition flex items-center justify-center opacity-0 group-hover:opacity-100">
                        <i class="fa-solid fa-expand text-white text-xl"></i>
                    </div>
                `;
                grid.appendChild(div);
            });
        }

        function moveCarousel(containerId, direction) {
            const container = document.querySelector(`#${containerId} > div`);
            const cardWidth = container.querySelector('div').offsetWidth + 20; // card + gap
            container.scrollBy({ left: cardWidth * direction, behavior: 'smooth' });
        }

        function scrollToCarouselItem(container, index) {
            const card = container.children[index];
            container.scrollTo({ left: card.offsetLeft - container.offsetLeft - 16, behavior: 'smooth' });
        }

        // ============= RENDERIZADO PRODUCTOS =============
        function filterSubcategory(subcat, btn) {
            currentSubcategory = subcat;
            updateSubcatButtons();
            renderProducts();
        }

        function updateSubcatButtons() {
            document.querySelectorAll('.subcat-btn').forEach(b => {
                b.classList.remove('bg-wire-yellow', 'text-white');
                b.classList.add('bg-wire-white', 'text-wire-graytext');
            });
            const activeBtn = [...document.querySelectorAll('.subcat-btn')].find(b => b.textContent.toLowerCase().includes(currentSubcategory.replace('-', ' ')));
            if(activeBtn) {
                activeBtn.classList.add('bg-wire-yellow', 'text-white');
                activeBtn.classList.remove('bg-wire-white', 'text-wire-graytext');
            }
        }

        function renderProducts() {
            const grid = document.getElementById('products-grid');
            grid.innerHTML = '';

            const filtered = PRODUCTS.filter(p => p.category === currentSubcategory);

            if (filtered.length === 0) {
                grid.innerHTML = `<p class="col-span-full text-center text-wire-graytext py-8 font-medium">No hay productos disponibles.</p>`;
                return;
            }

            filtered.forEach(prod => {
                const card = document.createElement('div');
                card.className = "bg-wire-card rounded-2xl p-3 shadow-sm border border-wire-text/10 flex flex-col transition hover:shadow-md";
                card.innerHTML = `
                    <div class="w-full aspect-square rounded-xl mb-3 border border-wire-text/10 overflow-hidden">
                        <img src="${prod.img}" onerror="this.onerror=null;this.src='${fallbackImg}';" alt="${prod.name}" class="w-full h-full object-cover hover:scale-105 transition">
                    </div>
                    <div class="flex-1">
                        <h3 class="font-bold text-wire-text text-sm sm:text-base">${prod.name}</h3>
                        <p class="text-[11px] text-wire-graytext leading-tight mt-1 mb-2">${prod.desc}</p>
                    </div>
                    <div class="flex items-center justify-between gap-2 mt-2">
                        <span class="font-bold text-wire-yellow text-base sm:text-lg">$${prod.price}</span>
                        <button onclick="addToCart(${prod.id})" class="bg-wire-yellow hover:bg-wire-yellow-hover text-white text-xs font-bold py-2 px-3 rounded-full transition shadow-xs">
                            Agregar
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // ============= MANEJO CARRITO =============
        function addToCart(prodId) {
            const prod = PRODUCTS.find(p => p.id === prodId);
            if (!prod) return;

            const existing = cart.find(item => item.id === prodId);
            if (existing) {
                existing.qty++;
            } else {
                cart.push({ id: prod.id, name: prod.name, price: prod.price, qty: 1, img: prod.img });
            }

            showToast(`Añadido: ${prod.name}`);
            renderCart();
        }

        function renderCart() {
            const container = document.getElementById('cart-items-container');
            const badge = document.getElementById('cart-badge-count');
            const totalElem = document.getElementById('cart-total-price');

            const totalCount = cart.reduce((acc, item) => acc + item.qty, 0);
            badge.innerText = totalCount;

            const totalPrice = cart.reduce((acc, item) => acc + (item.price * item.qty), 0);
            totalElem.innerText = `$${totalPrice.toLocaleString()}`;

            container.innerHTML = '';

            if (cart.length === 0) {
                container.innerHTML = `<div class="bg-wire-white/60 p-8 rounded-2xl text-center text-wire-graytext font-medium border border-dashed border-wire-text/25">Tu carrito está vacío. ¡Agrega algunos deliciosos productos!</div>`;
                return;
            }

            cart.forEach((item, index) => {
                const itemRow = document.createElement('div');
                itemRow.className = "bg-wire-white rounded-2xl p-3 shadow-sm border border-wire-text/10 flex items-center gap-4";
                itemRow.innerHTML = `
                    <div class="w-16 h-16 rounded-xl overflow-hidden border border-wire-text/10 flex-shrink-0">
                        <img src="${item.img}" onerror="this.onerror=null;this.src='${fallbackImg}';" class="w-full h-full object-cover" alt="${item.name}">
                    </div>
                    <div class="flex-1">
                        <h4 class="font-bold text-base text-wire-text">${item.name}</h4>
                        <span class="inline-block bg-wire-mint/20 text-wire-mint-dark text-xs font-bold px-2 py-0.5 rounded-full mt-1">
                            $${item.price}
                        </span>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="flex items-center bg-wire-bg rounded-full px-2 py-1 border border-wire-text/10">
                            <button onclick="updateQty(${index}, -1)" class="w-6 h-6 rounded-full bg-wire-text/10 text-wire-text font-bold text-xs flex items-center justify-center hover:bg-wire-text/20">-</button>
                            <span class="px-3 font-bold text-sm text-wire-text">${item.qty}</span>
                            <button onclick="updateQty(${index}, 1)" class="w-6 h-6 rounded-full bg-wire-yellow text-white font-bold text-xs flex items-center justify-center hover:bg-wire-yellow-hover">+</button>
                        </div>
                        <button onclick="removeItem(${index})" class="text-red-400 hover:text-red-600 p-1">
                            <i class="fa-solid fa-trash-can text-sm"></i>
                        </button>
                    </div>
                `;
                container.appendChild(itemRow);
            });
        }

        function updateQty(index, change) {
            if (cart[index]) {
                cart[index].qty += change;
                if (cart[index].qty <= 0) cart.splice(index, 1);
                renderCart();
            }
        }

        function removeItem(index) {
            cart.splice(index, 1);
            renderCart();
        }

        function clearCart() {
            cart = [];
            renderCart();
            showToast('Carrito vaciado');
        }

        function checkoutModal() {
            if (cart.length === 0) {
                showToast('Tu carrito está vacío');
                return;
            }
            showToast('¡Pedido realizado con éxito!');
            cart = [];
            renderCart();
        }

        // ============= UTILIDADES =============
        function saveProfile() {
            showToast('Perfil actualizado correctamente');
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            toastMsg.innerText = msg;

            toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-10');
            toast.classList.add('opacity-100', 'translate-y-0');

            setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-10');
            }, 2500);
        }

        // ============= INICIALIZACIÓN =============
        updateThemeIcon(); // Asegura que el ícono (sol/luna) coincida con el tema activo

        document.addEventListener('DOMContentLoaded', () => {
            renderCarousels();
            renderProducts();
            renderCart();
        });
    </script>
</body>
</html>
